# Required: at least 8 characters.
ADMIN_PASSWORD=change-this-admin-password

# Required for encrypted ChatGPT/session credential storage.
# Generate with: openssl rand -base64 32
SECURITY_CREDENTIAL_KEY=replace-with-base64-32-byte-key

# Optional outbound route for ChatGPT Web requests.
# Supported: http://, https://, socks5://, socks5h://
TRANSPORT_PROXY_URL=

# Optional host port.
GPT_MIRROR_PORT=9000
