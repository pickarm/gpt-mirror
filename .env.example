# Required: admin password, minimum 8 characters.
ADMIN_PASSWORD=change-me-now

# Required: AES-256-GCM credential key. Generate with:
#   openssl rand -base64 32
SECURITY_CREDENTIAL_KEY=replace-with-a-32-byte-base64-or-hex-key

# Optional host port for the web UI/API.
GPT_MIRROR_PORT=9000

# Browser-backed writes are enabled by default in the canonical Compose stack.
# Set false only if you intentionally want the HTTP-only write path.
CHATGPT_BROWSER_ENABLED=true

# Registry-backed releases use matching semantic tags for both images.
# Keep this value identical for the server and browser worker.
GPT_MIRROR_VERSION=latest
# Optional image overrides for forks/private registries.
GPT_MIRROR_IMAGE=ghcr.io/pickarm/gpt-mirror
GPT_MIRROR_BROWSER_IMAGE=ghcr.io/pickarm/gpt-mirror-browser

# Optional global outbound proxy. Supported schemes:
# http://, https://, socks5://, socks5h://
# Per-account proxy configuration takes precedence and is also used by the
# browser worker for that account's write operations.
TRANSPORT_PROXY_URL=
