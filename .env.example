# Required: admin password, minimum 8 characters.
ADMIN_PASSWORD=change-me-now

# Required: AES-256-GCM credential key. Generate with:
#   openssl rand -base64 32
SECURITY_CREDENTIAL_KEY=replace-with-a-32-byte-base64-or-hex-key

# Optional host port for the web UI/API.
GPT_MIRROR_PORT=9000

# Optional global outbound proxy. Supported schemes:
# http://, https://, socks5://, socks5h://
# Per-account proxy configuration takes precedence.
TRANSPORT_PROXY_URL=
